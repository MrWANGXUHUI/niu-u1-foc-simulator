.speed-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 20rpx 0 30rpx;
}

.speed {
  font-size: 120rpx;
  font-weight: 600;
  color: #7ee787;
  line-height: 1;
}

.unit {
  font-size: 32rpx;
  color: #8e8e96;
  margin-left: 12rpx;
}

.log {
  height: 360rpx;
}

.soc-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 8rpx 0 16rpx;
}

.soc {
  font-size: 88rpx;
  font-weight: 600;
  color: #58a6ff;
  line-height: 1;
}

.soc-unit {
  font-size: 28rpx;
  color: #8e8e96;
  margin-left: 8rpx;
}

.soc-bar {
  height: 14rpx;
  background: #21262d;
  border-radius: 7rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.soc-fill {
  height: 100%;
  background: #58a6ff;
}

.cell-bars {
  display: flex;
  align-items: flex-end;
  margin-top: 20rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #21262d;
}

.cell-bar {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.cell-fill {
  width: 60%;
  min-height: 20rpx;
  background: #3fb950;
  border-radius: 4rpx 4rpx 0 0;
}

.cell-text {
  font-size: 16rpx;
  color: #6e7681;
  margin-top: 6rpx;
  transform: scale(0.85);
}
